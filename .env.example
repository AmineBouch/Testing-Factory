# Copier ce fichier en .env et remplir les valeurs. Ne jamais publier le .env.

# Xray Cloud (API Keys : Jira > Apps > Xray > API Keys)
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=

# Email (SMTP Gmail avec mot de passe d'application)
MAIL_SMTP_USER=
MAIL_SMTP_APP_PASSWORD=
MAIL_TO=

# Slack : webhook entrant (+ token de bot xoxb- et ID de canal, optionnels, pour joindre les fichiers)
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Teams : URL du workflow « Publier dans un canal lorsqu'une demande de webhook est reçue »
TEAMS_WEBHOOK_URL=

# Garde-fous de l'agent (guard.py) : 1 = pause d'urgence, 0 = actif
AGENT_PAUSE=0
AGENT_MAX_TICKETS=40
